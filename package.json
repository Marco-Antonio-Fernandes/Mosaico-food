{
  "name": "mosaico-food",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/desktop run dev",
    "dev:web": "npm --workspace apps/desktop run dev:web",
    "dev:back": "npm --prefix ../mosaico-back run dev",
    "build": "npm --workspace apps/desktop run build",
    "build:back": "npm --prefix ../mosaico-back run build",
    "build:start": "npm run build:back && npm run build && MOSAICO_USE_LOCAL_BACKEND=1 MOSAICO_USE_BUILT_RENDERER=1 MOSAICO_ELECTRON_NO_SANDBOX=1 MOSAICO_LOCAL_BACKEND_ROOT=../mosaico-back electron --no-sandbox apps/desktop/electron/main.cjs",
    "typecheck": "npm --workspace apps/desktop run typecheck",
    "typecheck:back": "npm --prefix ../mosaico-back run typecheck",
    "db:generate": "npm --prefix ../mosaico-back run db:generate",
    "db:push": "npm --prefix ../mosaico-back run db:push"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
