# O desktop local e empacotado usam o backend compartilhado no servidor.
# Para testar outro backend, sobrescreva esta variável no ambiente do Electron.
MOSAICO_BACKEND_URL="https://mosaico.rotatix.com.br"
VITE_MOSAICO_BACKEND_URL="https://mosaico.rotatix.com.br"
# Servidor remoto exclusivo da integração com WhatsApp/WA-AKG.
VITE_MOSAICO_REMOTE_BACKEND_URL="https://mosaico.rotatix.com.br"
VITE_MOSAICO_API_KEY=""
# Somente neste ambiente de desenvolvimento Linux restrito:
# MOSAICO_ELECTRON_NO_SANDBOX="1"
