{
  "name": "@mosaico-food/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron electron/main.cjs\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "update:ncm": "node scripts/update-ncm-catalog.mjs",
    "prepare:speech": "node scripts/prepare-speech-runtime.mjs",
    "prepare:interpreter": "node scripts/prepare-local-interpreter.mjs",
    "package:linux": "npm --prefix ../../local-backend run build && npm run prepare:build-info && npm run prepare:speech && npm run prepare:interpreter && npm run build && npx --yes electron-builder --linux AppImage --config electron-builder.yml",
    "package:win": "npm --prefix ../../local-backend run build && npm run prepare:build-info && npm run prepare:speech && npm run prepare:interpreter && npm run build && npx --yes electron-builder --win --config electron-builder.yml",
    "preview": "vite preview",
    "prepare:build-info": "node scripts/write-build-info.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "33.4.11",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
